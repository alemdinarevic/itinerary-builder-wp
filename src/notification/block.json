{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "trip-itinerary/notification",
	"version": "0.1.0",
	"title": "Notification",
	"category": "widgets",
	"icon": "megaphone",
	"description": "One notification: a date, a title, a description and an optional link.",
	"parent": [ "trip-itinerary/notifications" ],
	"textdomain": "trip-itinerary",
	"attributes": {
		"title": {
			"type": "string",
			"role": "content"
		},
		"description": {
			"type": "string",
			"role": "content"
		},
		"date": {
			"type": "string"
		},
		"url": {
			"type": "string"
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
