{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "trip-itinerary/day",
	"version": "0.1.0",
	"title": "Day",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "One day of a trip, with a title and its own content.",
	"parent": [ "trip-itinerary/itinerary" ],
	"textdomain": "trip-itinerary",
	"attributes": {
		"title": {
			"type": "string",
			"role": "content"
		},
		"location": {
			"type": "string",
			"role": "content"
		},
		"photos": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		},
		"lat": {
			"type": "number"
		},
		"lng": {
			"type": "number"
		}
	},
	"usesContext": [ "trip-itinerary/startDate" ],
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
