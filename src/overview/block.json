{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "trip-itinerary/overview",
	"version": "0.1.0",
	"title": "Trip overview",
	"category": "widgets",
	"icon": "info-outline",
	"description": "The trip at a glance: its dates and travellers over a photo of the country, and each stop with a map.",
	"parent": [ "trip-itinerary/itinerary" ],
